# Copia este archivo como ".env" en esta misma carpeta y rellena tus propios
# valores. El ".env" real NO se sube al repositorio (ver .gitignore).

# Contraseña de la base de datos interna de Paperless (Postgres). Solo la usan
# los contenedores entre sí, pero no la dejes en el valor de ejemplo.
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA

# Clave secreta de Django. Genera una aleatoria propia (no reutilices esta ni
# ninguna de un tutorial); por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(50))"
PAPERLESS_SECRET_KEY=CAMBIA_ESTA_CLAVE_SECRETA
