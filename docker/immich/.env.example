# Copia como ".env" en esta carpeta y ajusta a tu instalación.
# El ".env" real NO se sube al repositorio (ver .gitignore).

# Carpeta donde Immich guarda las fotos que subas.
UPLOAD_LOCATION=./upload

# Unidad o carpeta con tu biblioteca externa de fotos, montada en solo lectura.
# Ejemplo real del autor: toda una unidad (F:\); ajusta a tu caso.
EXTERNAL_LIBRARY_LOCATION=F:\

# Carpeta donde Postgres guarda los datos de Immich.
DB_DATA_LOCATION=./postgres

DB_USERNAME=postgres
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA
DB_DATABASE_NAME=immich
